        np.testing.assert_allclose(matched.eps, reference.eps, rtol=2e-13, atol=2e-12)
        np.testing.assert_allclose(matched.p, reference.p, rtol=2e-13, atol=2e-12)
        mu_euler = (matched.eps + matched.p) / matched.nb

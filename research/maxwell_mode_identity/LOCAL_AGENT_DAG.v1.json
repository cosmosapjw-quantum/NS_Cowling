  "mathematical_contract": {
    "ode": "y'=M y, y=[W,V], M=[[nu'/chi,A/chi-ell*(ell+1)*exp(lambda)],[-exp(lambda)/r^2,2*nu']]",
    "A": "(omega*r/c)^2*exp(lambda-2nu)",
    "hypotheses": [
      "same background, omega, ell and sound-speed closure for both columns",
      "cold one-parameter barotrope",
      "d epsilon/dP=1/chi",
      "P'=-h nu'",
      "h=epsilon+P>0"
    ],
    "invariant": "Omega=h*exp(-nu)*(W1*V2-V1*W2)",
    "interface_jump": "Omega_o/Omega_i=(h_o/h_i)*exp(-(nu_o-nu_i))*det(T_inner_to_outer)",
    "slow_rapid_map_det": "h_i/h_o",
    "two_sided_match": "E(omega;rm)=h(rm)*exp(-nu(rm))*det(y_center(rm),y_surface(rm))",
    "caveats": [
      "bilinear without complex conjugation",
      "not a canonical covariant symplectic current",
      "not a cross-frequency invariant",
      "normalised angle is not a holomorphic Evans function",
      "nonbarotropic chi_ad != chi_eq requires a new weight/system derivation",
      "raw determinant is the exact analytic matching scalar only when coefficient and endpoint basis dependence is analytic; scale factors must be retained",
      "normalized determinant angle is real-frequency diagnostic only and is generally non-holomorphic for complex omega",
      "at Omega_inner=0 the observed interface ratio is undefined and must serialize as null plus status"
    ],
    "root_function_policy": {
      "raw_weighted_determinant": "exact_zero_set; preferred analytic scalar only with holomorphic ODE and endpoint bases",
      "normalized_angle": "real_frequency_conditioning_diagnostic_only",
      "complex_frequency": "use holomorphic scaled/exterior or multiple_shooting determinant; retain all scale phases",
      "qr_rule": "Y=Q*R; retain det(Q)*det(R), not Q alone",
      "zero_denominator_ratio": "null plus UNDEFINED_ZERO_DENOMINATOR; no NaN or infinity",
      "center": "finite-r_c regular series; leading W+ell*r_c*V=0",
      "surface": "same finite-pressure cutoff in both directions; not assumed P=0"
    }
  },

ClearAll[q,m,h,a,b,nn,np,ne]; nElec[q_]:=(q^2-m^2)^(3/2)/(3 Pi^2 h^3); pElec[q_]:=(q Sqrt[q^2-m^2](2 q^2-5 m^2)+3 m^4 Log[(q+Sqrt[q^2-m^2])/m])/(24 Pi^2 h^3); ass=q>m>0&&h>0; densityIdentities=FullSimplify[{D[pElec[q],q]-nElec[q],D[nElec[q],q]-q Sqrt[q^2-m^2]/(Pi^2 h^3)},Assumptions->ass]; conservedShift=a(nn+np)+b(np-ne); nucleonShift=a(nn+np)+b np; betaShift[shift_]:=D[shift,nn]-D[shift,np]-D[shift,ne]; pressureShift[shift_]:=nn D[shift,nn]+np D[shift,np]+ne D[shift,ne]-shift; {densityIdentities,FullSimplify[{betaShift[conservedShift],pressureShift[conservedShift],betaShift[nucleonShift],pressureShift[nucleonShift]}]}

{
  "schema": "ns-cowling.e390-rmf-parameter-sets",
  "schema_version": "1.0.0",
  "description": "RMF parameter sets for the GPPVA and SPG crust-model families. Each set defines the density-dependent meson-nucleon couplings (and meson masses) needed by the homogeneous-matter RMF solver (Scurto 2024 eq. 9-13, Gögelein 2008 eq. 40) that underlies the CLD crust reconstruction.",
  "units": {
    "masses": "MeV",
    "densities": "fm^-3",
    "energy_per_baryon": "MeV",
    "nucleon_mass": "M = 939.0 MeV (atomic mass unit approximation used for nuclear-matter E/A; the solver uses M_n=939.565, M_p=938.272 where needed for beta-equilibrium)"
  },
  "coupling_functional_forms": {
    "DD2_DDME2_TYYPEL": {
      "form": "g_kappa(rho) = a_kappa + (b_kappa + d_kappa*x)*exp(-c_kappa*x),  x = rho/rho_sat",
      "mesons": ["sigma", "omega", "rho"],
      "reference": "Typel, Ropke, Klahn, Blaschke, Wolter PRC 81 015803 (2010), eq. for the DD functional; same form for DD-ME2 (Lalazissis 2005) and TW99 (Typel-Wolter 1999).",
      "notes": "DD2, DD-ME2, TW99 and all GPPVA models except those with a different functional form use this Typel-style exponential. The delta meson is NOT included in these models."
    },
    "SPG_GOGELEIN": {
      "form": "g_kappa(rho_B) = a_kappa + (b_kappa + d_kappa*x^3)*exp(-c_kappa*x),  x = rho_B",
      "mesons": ["sigma", "omega", "delta", "rho"],
      "reference": "Gögelein, van Dalen, Fuchs, Muther PRC 77 025802 (2008), eq. 40 + Table I.",
      "notes": "SPG includes the delta meson (scalar isovector). g_omega and g_rho have d_kappa = 0 (the omega/rho rows in Table I have no d entry). Note x = rho_B directly (NOT rho/rho_sat) in the SPG form."
    }
  },

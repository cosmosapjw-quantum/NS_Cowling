{"created": "2025-04-29T09:03:26.636327+00:00", "modified": "2025-05-26T13:58:38.898547+00:00", "id": 15166920, "conceptrecid": "10781538", "doi": "10.5281/zenodo.15166920", "conceptdoi": "10.5281/zenodo.10781538", "doi_url": "https://doi.org/10.5281/zenodo.15166920", "metadata": {"title": "CUTER (Crust Unified Tool for Equation-of-state Reconstruction)", "doi": "10.5281/zenodo.15166920", "publication_date": "2025-04", "description": "<p dir=\"auto\">CUTER aims to provide the tools to calculate a unified, thermodynamically consistent crust from a given beta-equilibrium equation of state (EoS). If the minimum baryon number density provided by the input EoS is greater than 10^-4 fm^-3, CUTER will reconstruct the entire crust (i.e. outer+inner crust) using a few microphysics parameters. Otherwise, only the outer crust will be reconstructed using analytical representations of the Brussels-Montreal Skyrme (BSk) energy-density functionals to calculate the outer-crust properties.<br>The routines allow to compute the EoS of neutron star matter (and ultimately the observables of neutron stars). Compositional information is additionally available in the case of the whole-crust reconstruction and for the part given by the original EoS if previously provided by the user (see the README file for details). For this application, beta equilibrium at zero temperature is assumed.</p>\n<p dir=\"auto\">The tool is proposed by the LUTH-Caen group in Virgo.</p>\n<p dir=\"auto\">If you intend to make further developments on this code or you have comments, contact the original developers for advice and guidance regarding good practices.</p>\n<p dir=\"auto\">Contact: <a href=\"mailto:caen-luth-virgo-support@in2p3.fr\">caen-luth-virgo-support@in2p3.fr</a></p>", "access_right": "open", "creators": [{"name": "Davis, Philip John", "affiliation": "Laboratoire de Physique Corpusculaire de Caen", "orcid": "0009-0004-5008-5660"}, {"name": "Dinh Thi, Hoa", "affiliation": "Laboratoire de Physique Corpusculaire de Caen", "orcid": "0000-0001-9268-5577"}, {"name": "Fantina, Anthea Francesca", "affiliation": "Grand Acc\u00e9l\u00e9rateur National d'Ions Lourds", "orcid": "0000-0003-2225-4100"}, {"name": "Gulminelli, Francesca", "affiliation": "Laboratoire de Physique Corpusculaire de Caen", "orcid": "0000-0003-4354-2849"}, {"name": "Oertel, Micaela", "affiliation": "Observatoire astronomique de Strasbourg", "orcid": "0000-0002-1884-8654"}, {"name": "Suleiman, Lami", "affiliation": "California State University, Fullerton", "orcid": "0000-0003-3783-7448"}], "keywords": ["neutron stars", "dense matter", "equation of state"], "related_identifiers": [{"identifier": "10.1051/0004-6361/202348402", "relation": "isDescribedBy", "resource_type": "publication-article", "scheme": "doi"}, {"identifier": "10.1140/epja/s10050-025-01562-0", "relation": "isDescribedBy", "resource_type": "publication-article", "scheme": "doi"}], "version": "v2.3.2", "language": "eng", "custom": {"code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}, {"id": "fortran", "title": {"en": "Fortran"}}, {"id": "c", "title": {"en": "C"}}], "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Software", "type": "software"}, "journal": {"pages": "120", "title": "The European Physical Journal A", "volume": "61"}, "license": {"id": "mit-license"}, "grants": [{"code": "ANR-22-CE31-0001-01", "internal_id": "10.13039/501100001665::ANR-22-CE31-0001-01", "funder": {"name": "Agence Nationale de la Recherche", "doi": "10.13039/501100001665", "acronym": "ANR"}, "title": "Gravitational waves from hot neutron stars and properties of ultra-dense matter"}, {"code": "2018/29/B/ST9/02013", "internal_id": "03ha2q922::2018/29/B/ST9/02013", "funder": {"name": "National Science Centre"}, "title": "Grant"}, {"code": "2019/33/B/ST9/00942", "internal_id": "03ha2q922::2019/33/B/ST9/00942", "funder": {"name": "National Science Centre"}, "title": "Grant"}, {"code": "PHY 21-16686", "internal_id": "10.13039/100000001::PHY 21-16686", "funder": {"name": "U.S. National Science Foundation", "doi": "10.13039/100000001", "acronym": "NSF"}, "title": "Grant"}, {"code": "International Research Project (IRP)", "internal_id": "02feahw73::International Research Project (IRP)", "funder": {"name": "Centre National de la Recherche Scientifique"}, "title": "Origin of heavy elements in the Universe: Compact Stars and Nucleosynthesis / Origine des \u00e9l\u00e9ments lourds dans l\u2019univers : Astres  Compacts et Nucl\u00e9osynth\u00e8se (ACNu)"}, {"code": "Master project", "internal_id": "03fd77x13::Master project", "funder": {"name": "Institut National de Physique Nucl\u00e9aire et de Physique des Particules"}, "title": "\"Mod\u00e9lisation des astres compacts\" (NewMAC)"}], "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "10781538"}}]}}, "title": "CUTER (Crust Unified Tool for Equation-of-state Reconstruction)", "links": {"self": "https://zenodo.org/api/records/15166920", "self_html": "https://zenodo.org/records/15166920", "preview_html": "https://zenodo.org/records/15166920?preview=1", "doi": "https://doi.org/10.5281/zenodo.15166920", "self_doi": "https://doi.org/10.5281/zenodo.15166920", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.15166920", "reserve_doi": "https://zenodo.org/api/records/15166920/draft/pids/doi", "parent": "https://zenodo.org/api/records/10781538", "parent_html": "https://zenodo.org/records/10781538", "parent_doi": "https://doi.org/10.5281/zenodo.10781538", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.10781538", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:15166920/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:15166920/sequence/default", "files": "https://zenodo.org/api/records/15166920/files", "media_files": "https://zenodo.org/api/records/15166920/media-files", "latest": "https://zenodo.org/api/records/15166920/ver
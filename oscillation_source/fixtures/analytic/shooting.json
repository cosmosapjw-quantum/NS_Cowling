{
  "schema_version": 1,
  "kind": "analytic_BVP",
  "length_m": 1.0,
  "amplitude": 1.0,
  "search_k_per_m": [
    0.2,
    8.0
  ],
  "scan_n": 200,
  "equation": "y_second + k_squared*y = 0",
  "initial": "y(0)=0, dy/dx(0)=A",
  "boundary": "y(L)=0",
  "exact_k": "n*pi/L, integer n>=1",
  "solver_uses_exact_formula": false,
  "root_atol_per_m": 1e-07,
  "scope": "analytic algorithm verification only, not stellar modes"
}

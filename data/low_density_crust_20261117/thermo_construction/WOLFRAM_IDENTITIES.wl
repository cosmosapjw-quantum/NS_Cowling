Clear[a,d,x,m,nL,nR,pL,k,yL,yR]; ass=a>0&&d>0&&0<x<1&&Element[k,Reals]&&k!=0; p=pL+d nL x+d(3m-2nL-nR)x^2+d(-2m+nL+nR)x^3; nn=Expand[D[p,x]/d]; cc=Expand[(a+d x)D[nn,x]/d-nn]; j=(Exp[k x]((a+d x)/k-d/k^2)-a/k+d/k^2-a x-d x^2/2)/(Exp[k]-1); phi=(Exp[k x]-1)/(Exp[k]-1); yy=yL+(yR-yL)phi; nx=(a+d x)yy; ExportString[<|"cubic_margin_derivative_identity"->FullSimplify[D[cc,x]/d-6(a+d x)(nL+nR-2m)/d^2],"left_causal_bound"->FullSimplify[(cc/.x->0)/.m->(4nL+2nR+nL d/a)/6],"right_causal_bound"->FullSimplify[(cc/.x->1)/.m->(2nL+4nR-nR d/(a+d))/6],"primitive_derivative_identity"->FullSimplify[D[j,x]-(a+d x)phi,Assumptions->ass],"primitive_left_endpoint"->FullSimplify[j/.x->0,Assumptions->ass],"zero_k_limit_identity"->FullSimplify[Limit[j,k->0]-(a x^2/2+d x^3/3)],"n_over_mu_causal_identity"->FullSimplify[(a+d x)D[nx,x]/d-nx-(a+d x)^2 D[yy,x]/d]|>,"RawJSON"]

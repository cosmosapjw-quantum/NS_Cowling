{
  "schema": "ns-cowling.e390-rmf-parameter-sets",
  "schema_version": "1.1.0",
  "revision": "v1.1 - corrected DD2 to exact Typel 2010 Table III functional form (rational isoscalar + exponential isovector); SPG_Gögelein confirmed. Other GPPVA models pending exact-table extraction.",
  "description": "RMF parameter sets for the GPPVA and SPG crust-model families.",
  "units": {"masses": "MeV", "densities": "fm^-3", "energy_per_baryon": "MeV"},
  "coupling_functional_forms": {
    "DD2_TYYPEL_RATIONAL": {
      "isoscalar_form": "f_i(x) = a_i * [1 + b_i*(x + d_i)^2] / [1 + c_i*(x + d_i)^2],  g_i(n) = Gamma_i(n_sat) * f_i(x)",
      "isovector_form": "f_rho(x) = exp[-a_rho*(x - 1)],  g_rho(n) = Gamma_rho(n_sat) * f_rho(x)",
      "x": "x = n / n_sat",
      "mesons_isoscalar": ["omega", "sigma"],
      "mesons_isovector": ["rho"],
      "reference": "Typel, Ropke, Klahn, Blaschke, Wolter PRC 81 015803 (2010), eq. 75-77; arXiv:0908.2344",
      "notes": "DD2 uses this rational (isoscalar) + exponential (isovector) form, NOT the simple a+(b+dx)exp(-cx) form. The simple form was a wrong assumption in v1.0."
    },
    "SPG_GOGELEIN": {
      "form": "g_kappa(rho_B) = a_kappa + (b_kappa + d_kappa*x^3)*exp(-c_kappa*x),  x = rho_B",
      "mesons": ["sigma", "omega", "delta", "rho"],
      "reference": "Gögelein et al. PRC 77 025802 (2008), eq. 40 + Table I",
      "notes": "SPG includes delta. x = rho_B directly (fm^-3). All 4 mesons use the same functional form."
    }
  },
